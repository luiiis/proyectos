# ════════════════════════════════════════════════════════════════
# Fullstack 2026 - Variables de Entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitear .env al repositorio
# ════════════════════════════════════════════════════════════════

# ═══════ PostgreSQL ═══════
# Password del usuario 'postgres' (superusuario de la BD)
DB_PASSWORD=postgres123

# ═══════ Keycloak (Identity Provider) ═══════
# Password del admin de Keycloak (para acceder a http://localhost:8180)
KC_ADMIN_PASSWORD=admin123

# ═══════ PRODUCCIÓN (cambiar estos valores antes de desplegar) ═══════
# DB_PASSWORD=tu-password-seguro-de-32-caracteres
# KC_ADMIN_PASSWORD=keycloak-admin-seguro-2026

# ═══════ NOTAS ═══════
# Los demás servicios usan valores por defecto definidos en docker-compose.yml:
# - PostgreSQL: usuario=postgres, bd=fullstack2026, puerto=5432
# - Redis: sin password, puerto=6379
# - Keycloak: usuario admin, puerto=8180
# - Backend: puerto=8080
# - Frontend: puerto=80
#
# Para cambiar puertos, modificar docker-compose.yml directamente.
